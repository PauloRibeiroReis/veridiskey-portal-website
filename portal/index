
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Veridiskey Portal — Demo Access</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%2316a34a'/><path d='M16 7a5 5 0 0 0-5 5v3h-1.5a1 1 0 0 0-1 1v8.5a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1V16a1 1 0 0 0-1-1H21v-3a5 5 0 0 0-5-5zm-2.5 8v-3a2.5 2.5 0 1 1 5 0v3z' fill='white'/></svg>">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,300;1,9..40,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ── EXACT TOKEN MIRROR FROM VERIDISKEY.COM ── */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --g9:#052e16;--g8:#14532d;--g7:#166534;--g6:#16a34a;--g5:#22c55e;
  --g4:#4ade80;--g1:#dcfce7;--g0:#f0fdf4;--gb:rgba(22,163,74,.15);
  --t:#1a2e22;--tb:#3d5347;--td:#6b8577;--tl:#94a89d;
  --b:rgba(0,0,0,.06);
  --sh:0 1px 3px rgba(0,0,0,.04),0 4px 16px rgba(0,0,0,.04);
  --sl2:0 2px 6px rgba(0,0,0,.04),0 8px 32px rgba(0,0,0,.06)
}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',system-ui,sans-serif;font-size:15px;font-weight:400;background:#f8faf9;color:var(--tb);line-height:1.7;overflow-x:hidden}
a{color:inherit;text-decoration:none}

/* ── CANVAS BACKGROUND ── */
#bgCanvas{position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;pointer-events:none}

/* ── SCREENS (SPA routing) ── */
#root{width:100vw;height:100vh;overflow:hidden;position:relative}
.screen{position:absolute;inset:0;overflow-y:auto;overflow-x:hidden;opacity:0;pointer-events:none;transition:opacity .22s ease}
.screen.active{opacity:1;pointer-events:all}
::-webkit-scrollbar{width:5px}::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--g1);border-radius:3px}

/* ── NAV — exact veridiskey.com pattern ── */
.pnav{position:sticky;top:0;z-index:100;padding:.9rem 2.5rem;display:flex;align-items:center;justify-content:space-between;backdrop-filter:blur(14px);background:rgba(248,250,249,.88);border-bottom:1px solid var(--b)}
.pnav-logo{display:flex;align-items:center;gap:.55rem;font-size:15px;font-weight:700;letter-spacing:.04em;color:var(--g8);text-decoration:none}
.pnav-logo svg{width:26px;height:26px}
.pnav-right{display:flex;align-items:center;gap:1.2rem}
.pnav-back{font-size:13px;color:var(--td);cursor:pointer;background:none;border:none;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:.4rem;transition:color .2s}
.pnav-back:hover{color:var(--g6)}
.pnav-badge{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:.3rem .9rem;border-radius:20px;border:1px solid var(--gb);color:var(--g7);background:var(--g0)}
.pnav-rk{font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:.3rem .9rem;border-radius:20px;border:1px solid rgba(22,163,74,.25);color:var(--g6);background:var(--g0);cursor:pointer;display:flex;align-items:center;gap:.4rem}
.pnav-dot{width:6px;height:6px;border-radius:50%;background:var(--g5);animation:pulse-g 2s infinite}
@keyframes pulse-g{0%,100%{opacity:1}50%{opacity:.3}}
.pnav-primary{background:var(--g6);color:#fff;padding:.4rem 1.2rem;border-radius:6px;font-size:13px;font-weight:500;border:none;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .22s}
.pnav-primary:hover{background:var(--g7);transform:translateY(-1px)}

/* ── PAGE WRAPPER ── */
.page{position:relative;z-index:1;padding:2.5rem 2.5rem 5rem}
.si{max-width:1040px;margin:0 auto;position:relative;z-index:2}

/* ── SECTION LABELS — exact veridiskey.com .sl ── */
.sl{font-family:'DM Sans',sans-serif;font-size:11px;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--g6);margin-bottom:.7rem}

/* ── HEADINGS — exact veridiskey.com .st ── */
.st{font-family:'Playfair Display',Georgia,serif;font-size:clamp(24px,3.5vw,38px);font-weight:400;color:var(--g9);line-height:1.2;margin-bottom:.8rem}
.st em{font-style:italic;color:var(--g6);font-weight:400}

/* ── CARDS — exact veridiskey.com patterns ── */
.card-w{background:rgba(255,255,255,.88);border:1px solid var(--b);border-radius:12px;padding:1.8rem;transition:all .3s}
.card-w:hover{border-color:var(--gb);box-shadow:var(--sh)}
.card-gb{background:rgba(255,255,255,.9);border:1px solid var(--gb);border-radius:14px;padding:2rem 2.5rem}
.card-accent{background:rgba(255,255,255,.88);border:1px solid var(--gb);border-radius:14px;padding:2rem;position:relative;overflow:hidden}
.card-accent::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:linear-gradient(180deg,var(--g5),var(--g6))}

/* ── METRIC CARDS ── */
.metric-g{display:grid;gap:1rem}
.mc{background:rgba(255,255,255,.88);border:1px solid var(--b);border-radius:12px;padding:1.6rem 1.8rem;transition:all .3s}
.mc:hover{border-color:var(--gb);box-shadow:var(--sh)}
.mc-label{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--tl);margin-bottom:.4rem}
.mc-val{font-family:'Playfair Display',serif;font-size:36px;font-weight:400;color:var(--g9);line-height:1}
.mc-sub{font-size:12px;color:var(--td);margin-top:.3rem}

/* ── BADGES ── */
.badge{display:inline-flex;align-items:center;gap:.3rem;font-size:11px;font-weight:600;letter-spacing:.04em;padding:.25rem .8rem;border-radius:20px}
.badge::before{content:'';width:5px;height:5px;border-radius:50%;flex-shrink:0}
.b-valid{background:var(--g0);color:var(--g7);border:1px solid var(--gb)}.b-valid::before{background:var(--g5)}
.b-expiring{background:#fffbeb;color:#b45309;border:1px solid #fde68a}.b-expiring::before{background:#f59e0b}
.b-expired{background:#fef2f2;color:#b91c1c;border:1px solid #fecaca}.b-expired::before{background:#ef4444}
.b-rk{background:var(--g0);color:var(--g8);border:1px solid var(--gb)}.b-rk::before{background:var(--g6)}

/* ── RISK ── */
.risk{font-size:11px;font-weight:600;letter-spacing:.04em}
.r-low{color:var(--g6)}.r-med{color:#b45309}.r-high{color:#b91c1c}

/* ── TABLE ── */
.tbl{background:rgba(255,255,255,.9);border:1px solid var(--b);border-radius:12px;overflow:hidden;box-shadow:var(--sh)}
.tbl-head{display:grid;padding:.75rem 1.8rem;background:var(--g0);border-bottom:1px solid var(--gb)}
.tbl-head span{font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--tl)}
.tbl-row{display:grid;padding:1.1rem 1.8rem;border-bottom:1px solid rgba(0,0,0,.04);cursor:pointer;transition:background .12s;align-items:center}
.tbl-row:last-child{border-bottom:none}
.tbl-row:hover{background:rgba(240,253,244,.6)}

/* ── HITL ALERT (matches .hb2 from site) ── */
.hitl{background:linear-gradient(135deg,var(--g8),var(--g9));border-radius:14px;padding:2rem 2.5rem;margin-bottom:2rem;position:relative;overflow:hidden;display:flex;justify-content:space-between;align-items:center;gap:1.5rem}
.hitl::after{content:'';position:absolute;top:-40%;right:-8%;width:260px;height:260px;border-radius:50%;background:rgba(34,197,94,.07)}
.hitl-tag{font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--g4);margin-bottom:.4rem}
.hitl-title{font-family:'Playfair Display',serif;font-size:18px;font-weight:400;color:#fff;margin-bottom:.3rem}
.hitl-sub{font-size:13px;color:rgba(255,255,255,.65)}
.hitl-ok{background:rgba(240,253,244,.95);border:1px solid var(--gb);border-radius:12px;padding:1rem 1.5rem;margin-bottom:1.5rem;display:flex;align-items:center;gap:.7rem;animation:fadeUp .4s ease}
.hitl-ok span{font-size:14px;color:var(--g7);font-weight:500}
.btn-validate{background:var(--g6);color:#fff;border:none;padding:.6rem 1.4rem;border-radius:7px;font-size:13px;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .22s}
.btn-validate:hover{background:var(--g7)}
.btn-dismiss{background:rgba(255,255,255,.12);color:rgba(255,255,255,.75);border:none;padding:.6rem 1.2rem;border-radius:7px;font-size:13px;cursor:pointer;font-family:'DM Sans',sans-serif;transition:background .2s}
.btn-dismiss:hover{background:rgba(255,255,255,.2)}

/* ── BUTTONS ── */
.btn-g{background:var(--g6);color:#fff;border:none;padding:.6rem 1.6rem;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .22s;display:inline-flex;align-items:center;gap:.5rem}
.btn-g:hover{background:var(--g7);transform:translateY(-1px)}
.btn-g:active{transform:scale(.98)}
.btn-ghost{background:transparent;color:var(--g7);border:1px solid var(--gb);padding:.5rem 1.4rem;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .22s}
.btn-ghost:hover{background:var(--g0);border-color:var(--g6)}
.btn-outline{background:transparent;color:var(--td);border:1px solid var(--b);padding:.5rem 1.2rem;border-radius:8px;font-size:13px;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .22s}
.btn-outline:hover{border-color:var(--gb);color:var(--g7)}
.btn-rk-verify{background:var(--g0);color:var(--g8);border:1px solid var(--gb);padding:.6rem;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .22s;width:100%;text-align:center}
.btn-rk-verify:hover{background:var(--g1);border-color:var(--g6)}
.btn-rk-verify:disabled{opacity:.6;cursor:wait}

/* ── CREDENTIAL CARD (matches .pa from site) ── */
.cred-card{background:rgba(255,255,255,.9);border:1px solid var(--gb);border-radius:14px;padding:2rem 2rem 2rem 2.2rem;position:relative;overflow:hidden;display:flex;gap:1.5rem;margin-bottom:1.2rem;animation:fadeUp .3s ease}
.cred-card::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:linear-gradient(180deg,var(--g5),var(--g6))}
.cred-left{flex:1;min-width:0}
.cred-right{width:180px;flex-shrink:0}
.rk-panel{background:var(--g0);border:1px solid var(--gb);border-radius:10px;padding:1.2rem}
.rk-panel-title{font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--g6);margin-bottom:.9rem;display:flex;align-items:center;gap:.4rem}
.rk-fl{font-size:10px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--tl);margin-bottom:.2rem}
.rk-fv{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--g8);font-weight:500;margin-bottom:.9rem;word-break:break-all}
.rk-fv-sm{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--td);word-break:break-all;margin-bottom:.9rem}
.did-bar{display:flex;align-items:center;gap:.5rem;padding:.5rem .8rem;background:var(--g0);border-radius:6px;margin-top:.9rem}
.did-bar span{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--td);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cred-meta{display:flex;gap:1.8rem;flex-wrap:wrap;margin:.9rem 0}
.cf-label{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--tl);margin-bottom:.25rem}
.cf-val{font-size:14px;font-weight:500;color:var(--t)}

/* ── AUDIT EVENT DOT ── */
.ev-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}

/* ── FORM ── */
.fg{margin-bottom:1rem}
.fg label{display:block;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--td);margin-bottom:.35rem}
.fg input,.fg select,.fg textarea{width:100%;background:#fff;border:1px solid var(--b);border-radius:8px;padding:.65rem 1rem;font-family:'DM Sans',sans-serif;font-size:14px;color:var(--t);outline:none;transition:border-color .22s,box-shadow .22s}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--g5);box-shadow:0 0 0 3px rgba(22,163,74,.08)}
.fg textarea{resize:vertical;min-height:90px;line-height:1.6}
.fg select{cursor:pointer}

/* ── ANIMATIONS ── */
@keyframes fu{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes spin{to{transform:rotate(360deg)}}
.fi{opacity:0;transform:translateY(22px);transition:opacity .55s ease,transform .55s ease}
.fi.v{opacity:1;transform:translateY(0)}
.spin{display:inline-block;animation:spin .7s linear infinite}

/* ── PILOT CTA box (matches .pilot-cta from site) ── */
.pilot-box{background:linear-gradient(135deg,var(--g0),#fff);border:2px solid var(--g5);border-radius:14px;padding:2rem 2.5rem;text-align:center;margin-top:1.5rem}
.pilot-box h4{font-family:'Playfair Display',serif;font-size:20px;font-weight:400;color:var(--g9);margin-bottom:.4rem}
.pilot-box h4 em{font-style:italic;color:var(--g6)}
.pilot-box p{font-size:14px;color:var(--td);margin-bottom:1rem;line-height:1.7}

/* ── LOGIN SPECIFIC ── */
#s-login{background:#f8faf9}
.login-wrap{display:flex;min-height:100vh}
.login-left{width:440px;flex-shrink:0;background:linear-gradient(165deg,var(--g8) 0%,var(--g9) 100%);display:flex;flex-direction:column;justify-content:space-between;padding:3.5rem;position:relative;overflow:hidden}
.login-left::before{content:'';position:absolute;top:-30%;right:-15%;width:300px;height:300px;border-radius:50%;background:rgba(34,197,94,.07)}
.login-left::after{content:'';position:absolute;bottom:-15%;left:-10%;width:200px;height:200px;border-radius:50%;background:rgba(74,222,128,.05)}
.login-right{flex:1;display:flex;align-items:center;justify-content:center;padding:3.5rem;background:rgba(255,255,255,.7);backdrop-filter:blur(12px)}
.ll-ver{display:flex;align-items:center;gap:.6rem;margin-bottom:3rem}
.ll-ver-dot{width:7px;height:7px;border-radius:50%;background:var(--g4);animation:pulse-g 2s infinite}
.ll-ver span{font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.4)}
.ll-name{font-size:clamp(44px,7vw,72px);font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:#fff;line-height:.9;margin-bottom:.5rem;position:relative;z-index:1;animation:fu .7s ease both}
.ll-tag{font-family:'Playfair Display',serif;font-size:16px;font-weight:400;font-style:italic;color:rgba(255,255,255,.5);margin-bottom:3rem;position:relative;z-index:1;animation:fu .7s .1s ease both}
.ll-feats{display:flex;flex-direction:column;gap:.9rem;position:relative;z-index:1;animation:fu .7s .2s ease both}
.ll-feat{display:flex;align-items:center;gap:.7rem}
.ll-feat::before{content:'';width:4px;height:4px;border-radius:50%;background:var(--g4);flex-shrink:0}
.ll-feat span{font-size:13px;color:rgba(255,255,255,.5);font-weight:300}
.ll-bottom{position:relative;z-index:1;padding:1rem 1.2rem;border:1px solid rgba(255,255,255,.08);border-radius:8px;animation:fu .7s .3s ease both}
.ll-bottom p{font-family:'JetBrains Mono',monospace;font-size:9px;color:rgba(255,255,255,.25);letter-spacing:.5px}
.lf{width:100%;max-width:380px}
.lf-kicker{font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--g6);margin-bottom:.9rem}
.lf-h{font-family:'Playfair Display',serif;font-size:clamp(26px,4vw,40px);font-weight:400;color:var(--g9);line-height:1;margin-bottom:2.2rem}
.lf-h em{font-style:italic;color:var(--g6)}
.role-label{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--tl);margin-bottom:.8rem}
.role-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:1.5rem}
.role-btn{background:rgba(255,255,255,.85);border:1.5px solid var(--b);border-radius:10px;padding:1rem .9rem;cursor:pointer;text-align:left;transition:all .2s;font-family:'DM Sans',sans-serif}
.role-btn:hover{border-color:var(--gb);background:var(--g0)}
.role-btn.sel{border-color:var(--g6);background:var(--g0)}
.rb-icon{font-size:17px;margin-bottom:.5rem}
.rb-title{font-size:12px;font-weight:600;color:var(--g9);display:block;margin-bottom:.15rem}
.rb-sub{font-size:11px;color:var(--td);display:block;font-weight:300}
.login-note{margin-top:1rem;padding:.8rem 1rem;background:var(--g0);border-radius:7px;border:1px solid var(--gb)}
.login-note p{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--tl);letter-spacing:.3px}

/* ── DARK TECH PANEL (for ROOTKey) ── */
.tech-dark{background:linear-gradient(135deg,var(--g8),var(--g9));border-radius:14px;padding:2rem 2.5rem;position:relative;overflow:hidden}
.tech-dark::after{content:'';position:absolute;top:-30%;right:-8%;width:220px;height:220px;border-radius:50%;background:rgba(34,197,94,.07)}
.tech-dark .sl{color:var(--g4)}
.tech-dark h3{font-family:'Playfair Display',serif;font-size:clamp(20px,2.5vw,28px);font-weight:400;color:#fff;margin-bottom:.5rem}
.tech-dark h3 em{font-style:italic;color:var(--g4)}
.tech-dark p{font-size:15px;color:rgba(255,255,255,.6);line-height:1.75;font-weight:300}
.rk-stat{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:1rem 1.2rem}
.rk-stat-l{font-size:9px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.3);margin-bottom:.3rem}
.rk-stat-v{font-family:'JetBrains Mono',monospace;font-size:13px;color:rgba(255,255,255,.7)}
.rk-cert-row{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);border-radius:8px;padding:.9rem 1rem;display:flex;justify-content:space-between;align-items:center;margin-bottom:.6rem}
.rk-cert-name{font-family:'Playfair Display',serif;font-size:14px;color:rgba(255,255,255,.8);margin-bottom:.2rem;font-weight:400}
.rk-cert-sub{font-size:11px;color:rgba(255,255,255,.3)}
.rk-cert-id{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--g4);font-weight:500;text-align:right;margin-bottom:.2rem}
.rk-cert-hash{font-family:'JetBrains Mono',monospace;font-size:8px;color:rgba(255,255,255,.2)}

/* ── TRANSPARENCY ── */
.trans-row{display:grid;padding:1rem 1.8rem;border-bottom:1px solid rgba(0,0,0,.04);align-items:center}
.trans-row:last-child{border-bottom:none}

/* ── RESPONSIVE ── */
@media(max-width:768px){
  .login-left{display:none}
  .login-right{padding:2rem}
  .page{padding:1.5rem 1rem 4rem}
  .pnav{padding:.75rem 1.2rem}
}
</style>
</head>
<body>
<canvas id="bgCanvas"></canvas>
<div id="root">

<!-- ═══ LOGIN ═══ -->
<div id="s-login" class="screen">
  <div class="login-wrap">
    <div class="login-left">
      <div>
        <div class="ll-ver"><div class="ll-ver-dot"></div><span>Veridiskey Portal · Demo</span></div>
        <div class="ll-name">Veridis<br/>key</div>
        <div class="ll-tag">Trusted Infrastructure for Digital Cities</div>
        <div class="ll-feats">
          <div class="ll-feat"><span>Verified Credentials. Transparent Procurement.</span></div>
          <div class="ll-feat"><span>EBSI Verifiable Credentials · W3C VC 2.0</span></div>
          <div class="ll-feat"><span>ROOTKey immutable data certification</span></div>
          <div class="ll-feat"><span>SHA-256 tamper-proof audit trail</span></div>
          <div class="ll-feat"><span>eIDAS 2.0 · Procurement Act 2023 compliant</span></div>
        </div>
      </div>
      <div class="ll-bottom">
        <p>Strategic. Immutable. Human-Centred.</p>
      </div>
    </div>
    <div class="login-right">
      <div class="lf">
        <div class="lf-kicker">Demo Access</div>
        <h2 class="lf-h">Sign in to<br/><em>Portal</em></h2>
        <div class="role-label">Select your role</div>
        <div class="role-grid" id="role-grid">
          <button class="role-btn sel" data-role="officer" onclick="selectRole('officer',this)">
            <div class="rb-icon">🏛️</div>
            <span class="rb-title">Procurement Officer</span>
            <span class="rb-sub">Contract management · HITL</span>
